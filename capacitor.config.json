{
  "appId": "app.kraftwuerfel",
  "appName": "Kraftwürfel",
  "webDir": "dist",
  "backgroundColor": "#0D0E10",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0D0E10"
  },
  "android": {
    "backgroundColor": "#0D0E10"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0D0E10",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#26E1BE"
    }
  }
}
