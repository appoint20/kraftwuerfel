# Supabase project credentials (Project Settings -> API).
# Copy this file to .env and fill both values in.
# Leave them empty to run in local-only mode: data stays in this browser,
# there is no sign-in, and the AI coach is unreachable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local-only mode: try out the tiers without creating accounts.
# free | pro   (default: free). Ignored once Supabase is configured —
# roles then come from the profiles table.
VITE_LOCAL_ROLE=free
