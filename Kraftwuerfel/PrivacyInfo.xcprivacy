<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Datenschutzmanifest. Seit Mai 2024 Pflicht; ohne die Datei weist App Store
	  Connect den Upload zurück.

	  Was das Gerät verlässt und wohin:

	  POST /generate-plan (KI-Coach) und POST /challenge-plan (Home-Challenge)
	  senden Geschlecht, Alter, Größe, Gewicht, Zielgewicht, Trainingsziel,
	  Erfahrung, Trainingstage, Einheitsdauer, Equipment, Ernährungsform und
	  optionale Angaben zu Verletzungen an kraftwuerfel-api.onrender.com — mit
	  einem Zugriffstoken, also kontobezogen. Deshalb unten durchgehend
	  „verknüpft“ (Linked).

	  ACHTUNG, das stand hier vorher falsch: Der Dienst hat sehr wohl eine
	  Datenbank. In PostgreSQL liegen (a) das Konto — E-Mail, Passwort-Hash,
	  is_premium, Token-Hashes — und (b) die Tabelle plan_cache, die den
	  erzeugten Plan als JSON 14 Tage lang aufbewahrt, adressiert über einen
	  SHA-256-Schlüssel aus genau diesen Antworten. Der Schlüssel ist nicht
	  umkehrbar und enthält keine Kontokennung, aber der zwischengespeicherte
	  Plan ist aus Gesundheitsangaben abgeleitet und liegt persistent. Die
	  frühere Aussage „der Dienst hat keine Datenbank, die Werte werden nur
	  durchgereicht“ war damit nicht mehr zutreffend.

	  App Store Connect muss unter „App-Datenschutzangaben“ dieselben Angaben
	  tragen, sonst stimmen App und Store-Eintrag nicht überein.

	  Werbung: NSPrivacyTracking bleibt false und NSPrivacyTrackingDomains leer,
	  weil kein Werbenetz eingebunden ist (siehe AdManager.adsEnabled). Wird das
	  eingeschaltet, gehören hierher die Tracking-Domains, in die Info.plist eine
	  NSUserTrackingUsageDescription und in den Code die ATT-Abfrage.
	-->

	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!--
			  Geschlecht, Alter, Größe, Gewicht, Zielgewicht und angegebene
			  Einschränkungen/Verletzungen — die Eingaben, die den erzeugten Plan
			  auf den Körper zuschneiden. Gilt für den KI-Coach und für den
			  Fragebogen der Home-Challenge gleichermaßen.

			  Die Herzfrequenz aus HealthKit gehört NICHT dazu: Sie wird nur
			  gelesen und in der Live-Session angezeigt, sie verlässt das Gerät
			  nicht und wird nirgends gespeichert.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  Trainingsziel, Erfahrungsstufe, Ausrüstung, Fokus, Methode, Tage,
			  Einheitsdauer und die Länge der Challenge in Tagen — dieselbe
			  Anfrage, fitnessbezogener Teil.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  E-Mail-Adresse für Konto und Anmeldung. Sie liegt in unserer eigenen
			  PostgreSQL-Datenbank (nicht mehr Supabase — das stand hier veraltet)
			  und geht für Bestätigungs- und Reset-Mails an Mailjet.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!--
			  Anzeigename / Vorname für die persönliche Ansprache.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  UserDefaults ist eine API mit Begründungspflicht. CA92.1: Zugriff
			  ausschließlich auf die eigenen Daten der App, nicht auf die
			  anderer Apps und nicht zur Identifizierung des Geräts.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
