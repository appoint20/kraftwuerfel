<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleDisplayName</key>
	<string>Kraftwürfel</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  Ohne diesen Schlüssel bleibt jeder Upload an der Exportfrage hängen,
	  statt in TestFlight anzukommen. `false` heißt: keine nicht-ausgenommene
	  Verschlüsselung — die App spricht nur über HTTPS, und das ist
	  ausgenommen. Sobald eigene Kryptografie dazukommt, muss der Wert neu
	  bewertet werden.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSAppleMusicUsageDescription</key>
	<string>Kraftwürfel spielt Titel aus deiner Mediathek während der Live-Session ab.</string>

	<!--
	  Nur Lesen, und nur die Herzfrequenz. Die App schreibt vom iPhone aus
	  nichts nach Apple Health: eine HKWorkoutSession gibt es ausschließlich auf
	  watchOS, und die Werte, die diese App auf dem iPhone allein anzeigt, sind
	  Schätzungen. NSHealthUpdateUsageDescription ist deshalb bewusst nicht
	  gesetzt — das Recht zu schreiben liegt bei der Uhr, die auch misst.
	-->
	<key>NSHealthShareUsageDescription</key>
	<string>Kraftwürfel liest deine Herzfrequenz mit, um sie während der Live-Session anzuzeigen. Ohne Zugriff zeigt die App stattdessen einen als Schätzung gekennzeichneten Wert.</string>

	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<key>UIAppFonts</key>
	<array>
		<string>BebasNeue-Regular.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Inter-Medium.ttf</string>
		<string>Inter-SemiBold.ttf</string>
		<string>Inter-Bold.ttf</string>
		<string>JetBrainsMono-Medium.ttf</string>
		<string>JetBrainsMono-Bold.ttf</string>
	</array>

	<!--
	  "audio" für den Musikspieler in der Live-Session. "workout-processing"
	  stand hier früher mit — das ist ein watchOS-Modus (dort heißt der
	  Schlüssel WKBackgroundModes) und auf iOS wirkungslos. Er liegt jetzt im
	  watchOS-Ziel, wo die HKWorkoutSession läuft.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
